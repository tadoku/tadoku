load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

exports_files([
    "auth.yaml",
    "admin.yaml",
    "tadoku-api.yaml",
    "tadoku-worker.yaml",
    "webv2.yaml",
])

pkg_tar(
    name = "seed_fixtures_layer",
    srcs = [
        "//scripts/dev/seed:content.sql",
        "//scripts/dev/seed:immersion.sql",
        "//scripts/dev/seed:profile.sql",
    ],
    mode = "0644",
    package_dir = "/seed",
)

pkg_tar(
    name = "tenant_seed_layer",
    srcs = ["seed.sql"],
    mode = "0644",
    package_dir = "/",
)

pkg_tar(
    name = "tenant_binary_layer",
    srcs = ["//services/tadoku-api/cmd/tadoku-tenant:tadoku-tenant"],
    mode = "0755",
)

pkg_tar(
    name = "tenant_script_layer",
    srcs = ["tenant.sh"],
    mode = "0755",
)

pkg_tar(
    name = "tenant_flipt_layer",
    srcs = ["//k8s/dev/base/flipt:features.yaml"],
    mode = "0644",
    package_dir = "/flipt",
)

oci_image(
    name = "tenant_image",
    base = "@tadoku_dev_postgres_linux_amd64",
    entrypoint = ["/tenant.sh"],
    tars = [
        ":seed_fixtures_layer",
        ":tenant_seed_layer",
        ":tenant_binary_layer",
        ":tenant_script_layer",
        ":tenant_flipt_layer",
    ],
    user = "65532:65532",
)

oci_push(
    name = "tenant_push",
    image = ":tenant_image",
)
