load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

exports_files([
    "tadoku-api.yaml",
    "webv2.yaml",
])

pkg_tar(
    name = "seed_fixtures_layer",
    srcs = [
        "//scripts/dev/seed:content.sql",
        "//scripts/dev/seed:immersion.sql",
        "//scripts/dev/seed:profile.sql",
    ],
    mode = "0644",
    package_dir = "/seed",
)

pkg_tar(
    name = "seed_layer",
    srcs = ["seed.sql"],
    mode = "0644",
    package_dir = "/",
)

oci_image(
    name = "seed_image",
    base = "@tadoku_dev_postgres_linux_amd64",
    cmd = ["case \"$PGHOST/$PGDATABASE\" in tadoku-dev-db.tdk-dev-data/tadoku-?*) ;; *) echo 'refusing seed outside a branch development database' >&2; exit 1;; esac; exec psql -X --set=ON_ERROR_STOP=1 --file=/seed.sql"],
    entrypoint = [
        "/bin/sh",
        "-ec",
    ],
    tars = [
        ":seed_fixtures_layer",
        ":seed_layer",
    ],
    user = "65532:65532",
)

oci_push(
    name = "seed_push",
    image = ":seed_image",
)
