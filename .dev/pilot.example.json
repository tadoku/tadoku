    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "tadoku-dev-cli",
        "labels": {
          "app.kubernetes.io/managed-by": "tadoku-dev-cli-pilot",
          "app.kubernetes.io/part-of": "tadoku-dev-cli",
          "dev-cli.io/routing-enabled": "true"
