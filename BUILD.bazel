load("@gazelle//:def.bzl", "gazelle")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# gazelle:prefix github.com/tadoku/tadoku
gazelle(name = "gazelle")

exports_files([
    ".depolicy.yaml",
    "feature-flags.contract.json",
])

# Loads all service images in one `bazel run //:load_images` invocation.
# Used by CI (.github/workflows/build-bazel.yaml); add new production oci_load
# targets to both args and data below.
sh_binary(
    name = "load_images",
    srcs = ["tools/ci/run_bazel_images.sh"],
    args = [
        "$(rlocationpath //services/image-webhook-gateway:load)",
        "$(rlocationpath //services/tadoku-api:load)",
        "$(rlocationpath //services/tadoku-api/cmd/tadoku-worker:load)",
        "$(rlocationpath //services/tadoku-api/migrations:load)",
        "$(rlocationpath //services/token-reflector:load)",
    ],
    data = [
        "//services/image-webhook-gateway:load",
        "//services/tadoku-api:load",
        "//services/tadoku-api/cmd/tadoku-worker:load",
        "//services/tadoku-api/migrations:load",
        "//services/token-reflector:load",
        "@bazel_tools//tools/bash/runfiles",
    ],
)

# Pushes all service images in one `bazel run //:push_images` invocation.
# Used by CI (.github/workflows/build-bazel.yaml); add new production oci_push
# targets to both args and data below. Pushing an unchanged image is a no-op,
# so a tag moves only when that image's own digest changes.
sh_binary(
    name = "push_images",
    srcs = ["tools/ci/run_bazel_images.sh"],
    args = [
        "$(rlocationpath //services/image-webhook-gateway:push)",
        "$(rlocationpath //services/tadoku-api:push)",
        "$(rlocationpath //services/tadoku-api/cmd/tadoku-worker:push)",
        "$(rlocationpath //services/tadoku-api/migrations:push)",
        "$(rlocationpath //services/token-reflector:push)",
    ],
    data = [
        "//services/image-webhook-gateway:push",
        "//services/tadoku-api:push",
        "//services/tadoku-api/cmd/tadoku-worker:push",
        "//services/tadoku-api/migrations:push",
        "//services/token-reflector:push",
        "@bazel_tools//tools/bash/runfiles",
    ],
)
