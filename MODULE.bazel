module(
    name = "tadoku",
    version = "1.0.0",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "keto_v25_4_0",
    build_file_content = "exports_files([\"keto\"])\n",
    sha256 = "9241ee405b3ed0ecd03e3506ecc8485dd8d8a05e5dc9ea011853eb5800ed31c9",
    urls = ["https://github.com/ory/keto/releases/download/v25.4.0/keto_25.4.0-linux_sqlite_64bit.tar.gz"],
)

http_archive(
    name = "kratos_v26_2_0",
    build_file_content = "exports_files([\"kratos\"])\n",
    sha256 = "c80113f2c861b2fbd80290697d1380000111e297716018617423cca7f2e7e668",
    urls = ["https://github.com/ory/kratos/releases/download/v26.2.0/kratos_26.2.0-linux_sqlite_64bit.tar.gz"],
)

# Golang

bazel_dep(name = "rules_go", version = "0.62.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "platforms", version = "1.1.0")

# Shell

bazel_dep(name = "rules_shell", version = "0.8.0")

## Go version
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(
    name = "tadoku_go_sdk",
    go_mod = "//:go.mod",
)
use_repo(go_sdk, "tadoku_go_sdk")

## Read deps from go.mod
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

## All *direct* Go dependencies of the module have to be listed explicitly.
use_repo(
    go_deps,
    "com_github_bwmarrin_discordgo",
    "com_github_deepmap_oapi_codegen",
    "com_github_getkin_kin_openapi",
    "com_github_getsentry_sentry_go",
    "com_github_go_playground_validator_v10",
    "com_github_golang_jwt_jwt_v4",
    "com_github_golang_migrate_migrate_v4",
    "com_github_google_uuid",
    "com_github_jackc_pgconn",
    "com_github_jackc_pgerrcode",
    "com_github_jackc_pgx_v4",
    "com_github_jackc_pgx_v5",
    "com_github_kelseyhightower_envconfig",
    "com_github_labstack_echo_v4",
    "com_github_lib_pq",
    "com_github_mattn_go_sqlite3",
    "com_github_micahparks_keyfunc",
    "com_github_oapi_codegen_nullable",
    "com_github_oapi_codegen_runtime",
    "com_github_ory_keto_client_go",
    "com_github_ory_kratos_client_go",
    "com_github_pkg_errors",
    "com_github_prometheus_client_golang",
    "com_github_sahilm_fuzzy",
    "com_github_satorunooshie_depolicy",
    "com_github_stretchr_testify",
    "com_github_valkey_io_valkey_go",
    "io_flipt_go_flipt_client",
    "org_golang_x_sync",
    "org_golang_x_tools",
)

# Packaging

bazel_dep(name = "rules_pkg", version = "1.2.0")

# Containers

bazel_dep(name = "rules_oci", version = "2.3.0")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_base",
    digest = "sha256:fabbf1c0c357a3d42550111351daed089b20a2c954df13ee2fcff60602515e84",
    image = "gcr.io/distroless/base-debian12",
    platforms = [
        "linux/amd64",
    ],
)
use_repo(
    oci,
    "distroless_base",
    "distroless_base_linux_amd64",
)

# Development runtimes only; production images above remain unchanged.
oci.pull(
    name = "tadoku_dev_alpine",
    image = "index.docker.io/library/alpine",
    digest = "sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6",
    platforms = ["linux/amd64"],
)
oci.pull(
    name = "tadoku_dev_node",
    image = "index.docker.io/library/node",
    digest = "sha256:fa271c47a5d81dc321f4a45be01362f5b3de7559edc7e76b8c4089be1e50d866",
    platforms = ["linux/amd64"],
)
use_repo(oci, "tadoku_dev_alpine", "tadoku_dev_alpine_linux_amd64", "tadoku_dev_node", "tadoku_dev_node_linux_amd64")

oci.pull(
    name = "tadoku_dev_postgres",
    image = "index.docker.io/library/postgres",
    digest = "sha256:86c951e05bf56c93d95d397747fb8820ac76cc3bedb78f43abd83eedbe3666ae",
    platforms = ["linux/amd64"],
)
use_repo(oci, "tadoku_dev_postgres", "tadoku_dev_postgres_linux_amd64")

# Match frontend/Dockerfile.dev; no Corepack or new JS build framework.
http_archive(
    name = "tadoku_dev_pnpm",
    urls = ["https://registry.npmjs.org/pnpm/-/pnpm-10.10.0.tgz"],
    integrity = "sha512-1hXbJG/nDyXc/qbY1z3ueCziPiJF48T2+Igkn7VoFJMYY33Kc8LFyO8qTKDVZX+5VnGIv6tH9WbR7mzph4FcOQ==",
    strip_prefix = "package",
    build_file_content = """
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files", "strip_prefix")
pkg_files(
    name = "files",
    srcs = glob(["**"], exclude = ["BUILD.bazel", "WORKSPACE", "REPO.bazel"]),
    prefix = "/opt/pnpm",
    strip_prefix = strip_prefix.from_root(),
    attributes = pkg_attributes(mode = "0755"),
)
pkg_tar(
    name = "layer",
    srcs = [":files"],
    visibility = ["//visibility:public"],
)
""",
)
