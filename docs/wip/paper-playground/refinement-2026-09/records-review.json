{
  "scope": "Profile overview and activity, log details, admin dashboard and all admin sections",
  "updated": "2026-09-12",
  "direction": "Personal reading records with a coherent annual summary; a contained log entry with secondary score context; an admin workspace centered on the review queue.",
  "files": [
    "frontend/apps/paper-playground/src/pages/ProfilePages.tsx",
    "frontend/apps/paper-playground/src/pages/LogPage.tsx",
