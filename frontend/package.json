{
  "name": "frontend",
  "repository": "github.com/tadoku/tadoku/frontend",
  "license": "MIT",
  "private": true,
  "pnpm": {
    "overrides": {
      "react": "18.2.0",
      "react-dom": "18.2.0",
      "vitest>vite": "8.1.6"
    },
    "patchedDependencies": {
      "react-dom@18.2.0": "patches/react-dom@18.2.0.patch"
    }
  },
  "scripts": {
    "webv2": "pnpm --filter 'webv2' dev",
    "admin": "pnpm --filter 'admin' dev",
    "styleguide": "pnpm --filter 'styleguide' dev",
    "paper-styleguide": "pnpm --filter 'paper-styleguide' dev",
    "build": "pnpm run -r build",
    "check:paper-boundaries": "node scripts/check-paper-boundaries.mjs",
    "paper-playground": "pnpm --filter paper-playground dev",
    "webv3": "pnpm --filter webv3 dev",
    "authv2": "pnpm --filter authv2 dev"
  },
  "devDependencies": {
    "vite": "8.1.6"
  }
}
