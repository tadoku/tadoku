{
  "name": "paper-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./assets/*": "./dist/assets/*",
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js"
    },
    "./tailwind-preset": {
      "require": "./dist/tailwind-preset.cjs",
      "default": "./dist/tailwind-preset.cjs"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup && node scripts/build-assets.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "consumer:ts49": "node ../../node_modules/typescript-4/bin/tsc --noEmit -p tests/consumer-4.9/tsconfig.json",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": ">=7.40.0 <8"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@heroicons/react": "2.2.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "20.19.25",
    "@types/react": "18.0.26",
    "@types/react-dom": "18.0.9",
    "@types/scheduler": "0.16.8",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.2",
    "jsdom": "27.0.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "7.40.0",
    "tsup": "8.5.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-4": "npm:typescript@4.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
