load('ext://helm_resource', 'helm_resource', 'helm_repo')
load('ext://secret', 'secret_from_dict', 'secret_yaml_generic')
load('ext://configmap', 'configmap_yaml')
load('./../../../k8s/dev/config/Tiltfile', 'render_template', 'repo_path')

helm_repo('ory', 'https://k8s.ory.sh/helm/charts', resource_name='helm-repo-ory', labels=["auth"])

kratos_values = render_template('infra/dev/ory/kratos_values.yaml', '.tilt/rendered/infra/dev/ory/kratos_values.yaml')
oathkeeper_values = render_template('infra/dev/ory/oathkeeper_values.yaml', '.tilt/rendered/infra/dev/ory/oathkeeper_values.yaml')
access_rules = render_template('infra/dev/ory/access_rules.yaml', '.tilt/rendered/infra/dev/ory/access_rules.yaml')

oathkeeper_authz_token_script = repo_path('infra/dev/ory/resolve_oathkeeper_authz_token.py')
read_file(oathkeeper_authz_token_script)
oathkeeper_authz_token = str(local(
    [
        'python3',
        oathkeeper_authz_token_script,
        '--context',
        k8s_context(),
        '--cache',
        repo_path('.tilt/generated/oathkeeper_authz_token'),
    ],
    quiet=True,
    echo_off=True,
)).strip()

# kratos
helm_resource('kratos',
              'ory/kratos',
              flags=[
                '--version=0.32.0',
                '-f', kratos_values,
              ],
              deps=['./kratos_values.yaml'],
              resource_deps=['helm-repo-ory', 'tadoku-dev-db-ready'])

k8s_resource("kratos", labels=["auth"])

# oathkeeper
k8s_yaml(secret_yaml_generic('dev-oathkeeper-jwks', from_file=['jwks.json=./jwks-dev.json']))
k8s_yaml(secret_from_dict(
    'dev-oathkeeper-authz',
    namespace='default',
    inputs={'token': oathkeeper_authz_token},
))
k8s_yaml(secret_from_dict(
    'dev-oathkeeper-authz',
    namespace='tdk-authz-api',
    inputs={'token': oathkeeper_authz_token},
))
helm_resource('oathkeeper',
              'ory/oathkeeper',
              flags=[
                '--version=0.63.0',
                '--set-file', 'oathkeeper.accessRules=%s' % access_rules,
                '-f', oathkeeper_values,
              ],
              deps=['./access_rules.yaml', './oathkeeper_values.yaml', oathkeeper_authz_token_script],
              resource_deps=['helm-repo-ory'])

k8s_resource("oathkeeper", labels=["auth"])

# keto
k8s_yaml(configmap_yaml('keto-namespaces', from_file=[
  'namespaces.keto.ts=./namespaces.keto.ts',
]))
k8s_yaml('./keto_seed_admin_job.yaml')
helm_resource('keto',
              'ory/keto',
              flags=[
                '-f', './keto_values.yaml',
              ],
              deps=['./keto_values.yaml', './namespaces.keto.ts'],
              resource_deps=['helm-repo-ory', 'tadoku-dev-db-ready'])

k8s_resource("keto", labels=["auth"])
k8s_resource(
  "keto-seed-admin",
  labels=["auth"],
  resource_deps=["kratos", "keto"],
  trigger_mode=TRIGGER_MODE_MANUAL,
  auto_init=False,
)
