# -*- mode: Python -*-

load('./config/Tiltfile', 'is_shared_cluster', 'render_template', 'repo_path')

if not is_shared_cluster():
    include('./postgres-operator/Tiltfile')
    include('../../infra/dev/gateway/Tiltfile')

postgres_yaml = render_template('k8s/dev/postgres.yaml', '.tilt/rendered/k8s/dev/postgres.yaml')
k8s_yaml(postgres_yaml)

postgres_deps = []
if not is_shared_cluster():
    postgres_deps.append('postgres-operator')
k8s_resource(
    objects=[
        'tadoku-dev-db:postgresql:default',
    ],
    new_name='tadoku-dev-db',
    labels=['infra'],
    resource_deps=postgres_deps,
)

local_resource(
    'tadoku-dev-db-ready',
    cmd=[
        'kubectl',
        '--context',
        k8s_context(),
        '--namespace',
        'default',
        'wait',
        '--for=jsonpath={.status.PostgresClusterStatus}=Running',
        'postgresql.acid.zalan.do/tadoku-dev-db',
        '--timeout=300s',
    ],
    labels=['tools'],
    resource_deps=['tadoku-dev-db'],
)

# The Zalando operator creates credentials beside the Postgres resource in
# default, while each API runs in its own namespace. Copy only the four API
# credentials after provisioning; the target Namespace owns each copy so Tilt
# teardown garbage-collects it with the rest of that API's dev resources.
local_resource(
    'tadoku-dev-db-credentials',
    cmd=[
        repo_path('scripts/dev/sync-db-secrets.sh'),
        k8s_context(),
    ],
    deps=[
        repo_path('scripts/dev/sync-db-secrets.sh'),
    ],
    labels=['infra'],
    resource_deps=['tadoku-dev-db-ready', 'uncategorized'],
)

ingress_yaml = render_template('k8s/dev/ingress.yaml', '.tilt/rendered/k8s/dev/ingress.yaml')
k8s_yaml(ingress_yaml)
k8s_resource(
    objects=[
        'tadoku-web:ingress:default',
        'tadoku-api:ingress:default',
        'tadoku-auth-web:ingress:default',
        'tadoku-auth-stripped:ingress:default',
        'tadoku-flipt:ingress:default',
        'tadoku-admin-web:ingress:default',
        'tadoku-tools-stripped:ingress:default',
    ],
    new_name='tadoku-ingress',
    labels=['infra'],
    resource_deps=[
        'frontend-webv2',
        'frontend-auth',
        'frontend-admin',
        'flipt',
        'oathkeeper',
        'kratos',
        'mailhog',
        'pgweb',
    ],
)

k8s_yaml('./flipt.yaml')
k8s_resource(
    objects=[
        'tdk-flipt:namespace',
        'default-deny:networkpolicy:tdk-flipt',
        'allow-dns-egress:networkpolicy:tdk-flipt',
        'allow-oathkeeper-ingress:networkpolicy:tdk-flipt',
        'allow-monitoring-ingress:networkpolicy:tdk-flipt',
    ],
    new_name='flipt-network',
    labels=['infra'],
)
k8s_resource(
    objects=[
        'flipt:serviceaccount:tdk-flipt',
        'flipt:configmap:tdk-flipt',
    ],
    new_name='flipt-config',
    labels=['infra'],
    resource_deps=['flipt-network'],
)
k8s_resource(
    'flipt',
    labels=['infra'],
    resource_deps=['flipt-config', 'oathkeeper'],
)

include('../../infra/dev/ory/Tiltfile')
include('../../infra/dev/valkey/Tiltfile')
include('../../infra/dev/tools/Tiltfile')

include('../../services/token-reflector/Tiltfile')
include('../../services/immersion-api/Tiltfile')
include('../../services/content-api/Tiltfile')
include('../../services/profile-api/Tiltfile')
include('../../services/authz-api/Tiltfile')

include('../../frontend/Tiltfile')

local_resource(
    'dev-seed',
    cmd=repo_path('scripts/dev/seed-db.sh'),
    deps=[
        repo_path('scripts/dev/seed-db.sh'),
        repo_path('scripts/dev/seed/content.sql'),
        repo_path('scripts/dev/seed/immersion.sql'),
        repo_path('scripts/dev/seed/profile.sql'),
    ],
    labels=['infra'],
    resource_deps=[
        'authz-api',
        'content-api',
        'immersion-api',
        'profile-api',
        'kratos',
        'keto',
    ],
)

local_resource(
    'dev-reset',
    cmd=repo_path('scripts/dev/reset-env.sh'),
    deps=[
        repo_path('scripts/dev/reset-env.sh'),
        repo_path('scripts/dev/seed-db.sh'),
        repo_path('scripts/dev/seed/content.sql'),
        repo_path('scripts/dev/seed/immersion.sql'),
        repo_path('scripts/dev/seed/profile.sql'),
    ],
    labels=['infra'],
    auto_init=False,
    trigger_mode=TRIGGER_MODE_MANUAL,
)
