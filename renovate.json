{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 6am on monday"],
  "prHourlyLimit": 10,
  "prConcurrentLimit": 5,
  "dependencyDashboard": true,
  "automerge": false,
  "rebaseWhen": "behind-base-branch",
  "labels": ["dependencies"],
  // Pin Renovate's artifact pnpm to the same version CI uses
  // (.github/workflows/build-frontend-*.yaml → 10.10.0). Without this,
  // Renovate falls back to pnpm@latest for frontend/pnpm-lock.yaml; pnpm 11
  // ignores package.json pnpm.overrides and rewrites the lockfile without the
  // react/react-dom 18.2.0 pins (ERR_PNPM_LOCKFILE_CONFIG_MISMATCH on frozen
  // install). Hosted Mend does not allow arbitrary postUpgradeTasks on the
  // Community plan, so constraints.pnpm is the supported fix.
  "constraints": {
    "pnpm": "10.10.0"
  },
  "packageRules": [
    {
      "description": "Canonicalize Go module updates",
      "matchManagers": ["gomod"],
      "postUpdateOptions": ["gomodTidy"]
    },
    {
      // Gazelle tool module: hand-maintained require graph, no Go packages.
      // The global gomodTidy postUpdateOption empties go.mod/go.sum
      // (kin_openapi missing). Keep root-module Go updates + tidy as above.
      "description": "Disable tools/oapi-codegen updates (Gazelle tool module; gomodTidy empties it)",
      "matchFileNames": ["tools/oapi-codegen/**"],
      "enabled": false
    },
    {
      "description": "Group low-risk Bazel's rules patch/minor updates",
      "matchManagers": ["bazel"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "bazel rules (non-major)"
    },
    {
      "description": "Do not automerge majors; keep them reviewable",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Never bump Next.js — migrating to TanStack Start",
      "matchPackageNames": ["next", "eslint-config-next", "@next/*"],
      "enabled": false
    },
    {
      "description": "Never bump Echo — services being deprecated",
      "matchPackageNames": ["github.com/labstack/echo/v4", "github.com/labstack/echo"],
      "enabled": false
    }
  ]
}
