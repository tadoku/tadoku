load("./../../infra/dev/build/Tiltfile", "bazel_build")

# Api container
watch_file('./deployments/api.yaml')
k8s_yaml(local('cat ./deployments/api.yaml'))

bazel_build(
  'content-api-image',
  '//services/content-api:load',
  deps=['./', './../common/'],
)

k8s_resource('content-api-source-schema', labels=["tools"], resource_deps=["tadoku-dev-db-credentials"])
k8s_resource('content-api', labels=["backend"], resource_deps=["content-api-source-schema", "keto"])
