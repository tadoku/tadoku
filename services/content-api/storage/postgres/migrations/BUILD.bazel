load("@rules_pkg//:pkg.bzl", "pkg_tar")

filegroup(
    name = "up_files",
    srcs = glob(["*.up.sql"]),
    visibility = [
        "//services/immersion-api/storage/postgres/migrations:__pkg__",
        "//tools/database-convergence:__pkg__",
    ],
)

pkg_tar(
    name = "tar",
    srcs = glob(["**/*.sql"]),
    mode = "0644",
    package_dir = "/migrations",
    visibility = ["//services/content-api:__pkg__"],
)
