load("@rules_pkg//:pkg.bzl", "pkg_tar")

filegroup(
    name = "up_files",
    srcs = glob(["*.up.sql"]),
    visibility = [
        "//services/immersion-api/storage/postgres/migrations:__pkg__",
        "//services/profile-api/storage/postgres:__subpackages__",
    ],
)

pkg_tar(
    name = "tar",
    srcs = glob(
        ["**/*.sql"],
        allow_empty = True,
    ),
    mode = "0644",
    package_dir = "/migrations",
    visibility = ["//services/profile-api:__pkg__"],
)
