load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")
load("//.dev:deployable.bzl", "dev_deployable")

# Go import boundaries are enforced by the visibility of the imported package.
package_group(
    name = "feature_consumers",
    packages = [
        "//services/tadoku-api/app/...",
        "//services/tadoku-api/cmd/...",
        "//services/tadoku-api/e2e/...",
    ],
)

package_group(
    name = "domain_consumers",
    packages = [
        "//services/tadoku-api/app/...",
        "//services/tadoku-api/cmd/...",
        "//services/tadoku-api/domain/...",
        "//services/tadoku-api/e2e/...",
        "//services/tadoku-api/features/...",
        "//services/tadoku-api/spec/...",
    ],
)

package_group(
    name = "infrastructure_consumers",
    packages = [
        "//services/tadoku-api/app/...",
        "//services/tadoku-api/cmd/...",
        "//services/tadoku-api/e2e/...",
        "//services/tadoku-api/features/...",
        "//services/tadoku-api/infra/...",
        "//services/tadoku-api/spec/...",
        "//services/tadoku-api/storage/...",
    ],
)

package_group(
    name = "internal_consumers",
    packages = [
        "//services/tadoku-api/app/...",
        "//services/tadoku-api/cmd/...",
        "//services/tadoku-api/e2e/...",
        "//services/tadoku-api/features/...",
        "//services/tadoku-api/infra/...",
        "//services/tadoku-api/internal/...",
        "//services/tadoku-api/spec/...",
        "//services/tadoku-api/storage/...",
        "//services/tadoku-api/transport/...",
    ],
)

pkg_tar(
    name = "app_layer",
    srcs = ["//services/tadoku-api/cmd/tadoku-api"],
)

oci_image(
    name = "image",
    base = "@distroless_base_linux_amd64",
    entrypoint = ["/tadoku-api"],
    tars = [":app_layer"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = [
        "ghcr.io/tadoku/tadoku/tadoku-api:latest",
        "bazel/services/tadoku-api:latest",
    ],
    visibility = ["//visibility:public"],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = [
        "latest",
        "prod",
    ],
    repository = "ghcr.io/tadoku/tadoku/tadoku-api",
    visibility = ["//visibility:public"],
)

# Writable development runtime, separate from production's distroless image.
oci_image(
    name = "cli_image",
    base = "@tadoku_dev_alpine_linux_amd64",
    entrypoint = ["/tadoku-api"],
    tars = [":app_layer"],
    user = "65532:65532",
)

oci_push(
    name = "cli_push",
    image = ":cli_image",
)

dev_deployable(
    name = "dev",
    metadata = json.encode({
        "name": "tadoku-api",
        "kind": "backend",
        "namespace": "tdk-dev-tadoku-api",
        "buildTarget": "//services/tadoku-api/cmd/tadoku-api",
        "imageTarget": "//services/tadoku-api:cli_image",
        "imageName": "tadoku-api",
        "pushTarget": "//services/tadoku-api:cli_push",
        "containerPath": "/tadoku-api",
        "port": 8000,
        "servicePort": 80,
        "readinessPath": "/readyz",
        "publicPath": "/api/internal",
        "internalHost": "tadoku-cli-api.tdk-dev-oathkeeper.svc.cluster.local",
        "baseService": {
            "name": "tadoku-api",
            "namespace": "tdk-dev-tadoku-api",
            "port": 80,
        },
        "publicProxy": {
            "name": "oathkeeper-proxy",
            "namespace": "tdk-dev-oathkeeper",
            "port": 4455,
        },
        "devContainer": "tadoku-api",
        "sourceRoots": [
            "services/tadoku-api",
            "services/common",
        ],
    }),
    workload_template = "//.dev:tadoku-api.yaml",
    deps = [
        ":cli_image",
        "//services/tadoku-api/cmd/tadoku-api",
    ],
)
