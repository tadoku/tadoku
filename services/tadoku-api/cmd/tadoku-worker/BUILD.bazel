load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load", "oci_push")
load("@rules_pkg//:pkg.bzl", "pkg_tar")

go_library(
    name = "tadoku-worker_lib",
    srcs = [
        "email.go",
        "main.go",
    ],
    importpath = "github.com/tadoku/tadoku/services/tadoku-api/cmd/tadoku-worker",
    visibility = ["//visibility:private"],
    deps = [
        "//services/common/postgresconfig",
        "//services/tadoku-api/app/accountdeletion",
        "//services/tadoku-api/app/permissionmodel",
        "//services/tadoku-api/app/worker",
        "//services/tadoku-api/features/audit",
        "//services/tadoku-api/features/authz",
        "//services/tadoku-api/features/contestevents",
        "//services/tadoku-api/features/contests",
        "//services/tadoku-api/features/email",
        "//services/tadoku-api/features/identity",
        "//services/tadoku-api/features/jobqueue",
        "//services/tadoku-api/features/leaderboard",
        "//services/tadoku-api/features/logs",
        "//services/tadoku-api/features/profile",
        "//services/tadoku-api/infra/observability",
        "//services/tadoku-api/infra/postgres",
        "//services/tadoku-api/infra/smtp",
        "//services/tadoku-api/infra/valkey",
        "//services/tadoku-api/internal/permissions",
        "//services/tadoku-api/internal/tenant",
        "@com_github_go_playground_validator_v10//:validator",
        "@com_github_google_uuid//:uuid",
        "@com_github_kelseyhightower_envconfig//:envconfig",
        "@com_github_prometheus_client_golang//prometheus",
        "@com_github_prometheus_client_golang//prometheus/collectors",
        "@com_github_prometheus_client_golang//prometheus/promhttp",
    ],
)

go_binary(
    name = "tadoku-worker",
    embed = [":tadoku-worker_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "tadoku-worker_test",
    srcs = [
        "delete_account_test.go",
        "main_test.go",
    ],
    embed = [":tadoku-worker_lib"],
    env_inherit = ["TADOKU_TEST_POSTGRES_URL"],
    tags = [
        "no-cache",
        "no-remote-exec",
        "requires-network",
    ],
    deps = ["//services/tadoku-api/internal/testpostgres"],
)

pkg_tar(
    name = "binary_layer",
    srcs = [":tadoku-worker"],
)

oci_image(
    name = "image",
    base = "@distroless_base_linux_amd64",
    entrypoint = ["/tadoku-worker"],
    tars = [":binary_layer"],
    visibility = ["//services/tadoku-api:__pkg__"],
)

oci_load(
    name = "load",
    image = ":image",
    repo_tags = ["ghcr.io/tadoku/tadoku/tadoku-worker:latest"],
    visibility = ["//visibility:public"],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = [
        "latest",
        "prod",
    ],
    repository = "ghcr.io/tadoku/tadoku/tadoku-worker",
    visibility = ["//visibility:public"],
)

oci_image(
    name = "cli_image",
    base = "@tadoku_dev_alpine_linux_amd64",
    entrypoint = ["/tadoku-worker"],
    tars = [":binary_layer"],
    user = "65532:65532",
    visibility = ["//services/tadoku-api:__pkg__"],
)

oci_push(
    name = "cli_push",
    image = ":cli_image",
    visibility = ["//services/tadoku-api:__pkg__"],
)

oci_push(
    name = "branch_push",
    image = ":image",
    visibility = ["//services/tadoku-api:__pkg__"],
)
