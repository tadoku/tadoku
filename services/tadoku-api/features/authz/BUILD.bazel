load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "authz",
    srcs = [
        "authz_permissions.go",
        "authz_repository.go",
        "authz_service.go",
        "domain.go",
        "roles.go",
    ],
    importpath = "github.com/tadoku/tadoku/services/tadoku-api/features/authz",
    visibility = ["//services/tadoku-api:feature_consumers"],
    deps = [
        "//services/tadoku-api/features/identity",
        "//services/tadoku-api/generated/sqlc/authz",
        "//services/tadoku-api/infra/postgres",
        "//services/tadoku-api/internal/errx",
        "//services/tadoku-api/internal/identity",
        "//services/tadoku-api/internal/permissions",
        "//services/tadoku-api/internal/tenant",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

go_test(
    name = "authz_test",
    size = "medium",
    srcs = [
        "authz_checker_repository_test.go",
        "authz_checks_repository_test.go",
        "authz_cleanup_repository_test.go",
        "authz_fixtures_test.go",
        "authz_graph_test.go",
        "authz_read_repository_test.go",
        "authz_repository_test.go",
        "authz_service_test.go",
        "authz_writes_repository_test.go",
        "roles_test.go",
    ],
    args = ["-test.parallel=4"],
    embed = [":authz"],
    env_inherit = ["TADOKU_TEST_POSTGRES_URL"],
    tags = [
        "no-cache",
        "no-remote-exec",
        "requires-network",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        "//services/tadoku-api/infra/postgres",
        "//services/tadoku-api/internal/errx",
        "//services/tadoku-api/internal/identity",
        "//services/tadoku-api/internal/permissions",
        "//services/tadoku-api/internal/tenant",
        "//services/tadoku-api/internal/testpostgres",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)
