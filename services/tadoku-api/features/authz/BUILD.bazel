load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "authz",
    srcs = [
        "authz_repository.go",
        "authz_service.go",
        "domain.go",
    ],
    importpath = "github.com/tadoku/tadoku/services/tadoku-api/features/authz",
    visibility = ["//visibility:public"],
    deps = [
        "//services/common/authz/roles",
        "//services/common/client/kratos",
        "//services/tadoku-api/generated/sqlc/authz",
        "//services/tadoku-api/infra/postgres",
        "//services/tadoku-api/internal/errx",
        "//services/tadoku-api/internal/identity",
        "//services/tadoku-api/internal/permissions",
        "//services/tadoku-api/internal/timex",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//pgtype",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

go_test(
    name = "authz_test",
    srcs = [
        "authz_repository_test.go",
        "authz_service_test.go",
    ],
    args = ["-test.parallel=4"],
    embed = [":authz"],
    env_inherit = ["TADOKU_TEST_POSTGRES_URL"],
    tags = [
        "no-cache",
        "no-remote-exec",
        "requires-network",
    ],
    deps = [
        "//services/tadoku-api/internal/errx",
        "//services/tadoku-api/internal/identity",
        "//services/tadoku-api/internal/permissions",
        "//services/tadoku-api/internal/testpostgres",
        "@com_github_google_uuid//:uuid",
    ],
)
