load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "languages",
    srcs = [
        "domain.go",
        "languages_repository.go",
        "languages_service.go",
    ],
    importpath = "github.com/tadoku/tadoku/services/tadoku-api/features/languages",
    visibility = ["//services/tadoku-api:feature_consumers"],
    deps = [
        "//services/tadoku-api/domain/languages",
        "//services/tadoku-api/generated/sqlc/languages",
        "//services/tadoku-api/infra/postgres",
        "//services/tadoku-api/internal/errx",
        "@com_github_jackc_pgerrcode//:pgerrcode",
        "@com_github_jackc_pgx_v5//pgconn",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

go_test(
    name = "languages_test",
    srcs = [
        "languages_repository_test.go",
        "languages_service_test.go",
    ],
    env_inherit = ["TADOKU_TEST_POSTGRES_URL"],
    tags = [
        "no-cache",
        "no-remote-exec",
        "requires-network",
    ],
    deps = [
        ":languages",
        "//services/tadoku-api/internal/errx",
        "//services/tadoku-api/internal/testpostgres",
    ],
)
