load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "logs",
    srcs = [
        "domain.go",
        "logs_repository.go",
        "logs_service.go",
    ],
    importpath = "github.com/tadoku/tadoku/services/tadoku-api/features/logs",
    visibility = ["//services/tadoku-api:feature_consumers"],
    deps = [
        "//services/tadoku-api/domain/activities",
        "//services/tadoku-api/domain/jobs",
        "//services/tadoku-api/domain/leaderboardoutbox",
        "//services/tadoku-api/domain/logscore",
        "//services/tadoku-api/generated/sqlc/logs",
        "//services/tadoku-api/infra/postgres",
        "//services/tadoku-api/internal/errx",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgtype",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

go_test(
    name = "logs_test",
    srcs = ["logs_repository_test.go"],
    args = ["-test.parallel=4"],
    embed = [":logs"],
    env_inherit = ["TADOKU_TEST_POSTGRES_URL"],
    tags = [
        "no-cache",
        "no-remote-exec",
        "requires-network",
    ],
    deps = [
        "//services/tadoku-api/domain/activities",
        "//services/tadoku-api/domain/leaderboardoutbox",
        "//services/tadoku-api/internal/testpostgres",
        "@com_github_google_uuid//:uuid",
    ],
)
