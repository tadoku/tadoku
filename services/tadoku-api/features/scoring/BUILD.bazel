load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "scoring",
    srcs = [
        "domain.go",
        "scoring_repository.go",
        "scoring_service.go",
    ],
    importpath = "github.com/tadoku/tadoku/services/tadoku-api/features/scoring",
    visibility = ["//services/tadoku-api:feature_consumers"],
    deps = [
        "//services/tadoku-api/domain/activities",
        "//services/tadoku-api/domain/languages",
        "//services/tadoku-api/domain/logscore",
        "//services/tadoku-api/generated/sqlc/scoring",
        "//services/tadoku-api/infra/observability",
        "//services/tadoku-api/infra/postgres",
        "//services/tadoku-api/internal/errx",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

go_test(
    name = "scoring_test",
    srcs = [
        "scoring_repository_test.go",
        "scoring_service_test.go",
    ],
    args = ["-test.parallel=4"],
    embed = [":scoring"],
    env_inherit = ["TADOKU_TEST_POSTGRES_URL"],
    tags = [
        "no-cache",
        "no-remote-exec",
        "requires-network",
    ],
    deps = [
        "//services/tadoku-api/internal/errx",
        "//services/tadoku-api/internal/testpostgres",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgerrcode//:pgerrcode",
        "@com_github_jackc_pgx_v5//pgconn",
    ],
)
