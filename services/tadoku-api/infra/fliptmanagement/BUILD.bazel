load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "fliptmanagement",
    srcs = [
        "client.go",
        "features.go",
        "lifecycle.go",
    ],
    importpath = "github.com/tadoku/tadoku/services/tadoku-api/infra/fliptmanagement",
    visibility = ["//services/tadoku-api:infrastructure_consumers"],
    deps = [
        "//services/tadoku-api/infra/flipt",
        "//services/tadoku-api/internal/tenant",
        "@com_github_google_uuid//:uuid",
        "@in_yaml_go_yaml_v3//:yaml",
    ],
)

go_test(
    name = "fliptmanagement_test",
    srcs = [
        "client_test.go",
        "features_test.go",
        "lifecycle_test.go",
    ],
    data = glob(["testdata/**"]) + ["//k8s/dev/base/flipt:features.yaml"],
    embed = [":fliptmanagement"],
    deps = [
        "//services/tadoku-api/infra/flipt",
        "//services/tadoku-api/internal/tenant",
        "//services/tadoku-api/internal/testflipt",
        "@com_github_google_uuid//:uuid",
        "@rules_go//go/runfiles",
    ],
)
