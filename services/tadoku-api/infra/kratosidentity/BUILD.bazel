load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "kratosidentity",
    srcs = ["writer.go"],
    importpath = "github.com/tadoku/tadoku/services/tadoku-api/infra/kratosidentity",
    visibility = ["//services/tadoku-api:infrastructure_consumers"],
    deps = [
        "//services/tadoku-api/internal/tenant",
        "@com_github_google_uuid//:uuid",
        "@com_github_ory_kratos_client_go//:kratos-client-go",
    ],
)

go_test(
    name = "kratosidentity_test",
    srcs = ["writer_test.go"],
    data = glob(["testdata/*.sql"]),
    tags = [
        "no-cache",
        "no-remote-exec",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        ":kratosidentity",
        "//services/tadoku-api/infra/kratos",
        "//services/tadoku-api/internal/tenant",
        "//services/tadoku-api/internal/testkratos",
        "@com_github_google_uuid//:uuid",
    ],
)
