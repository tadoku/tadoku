load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:exclude pgbouncer_test.go

go_library(
    name = "postgres",
    srcs = [
        "errors.go",
        "metrics.go",
        "nullable.go",
        "pool.go",
        "timestamp.go",
        "transaction.go",
    ],
    importpath = "github.com/tadoku/tadoku/services/tadoku-api/infra/postgres",
    visibility = ["//services/tadoku-api:infrastructure_consumers"],
    deps = [
        "//services/tadoku-api/internal/tenant",
        "//services/tadoku-api/internal/tenant/alltenants",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgerrcode//:pgerrcode",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgconn",
        "@com_github_jackc_pgx_v5//pgtype",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@com_github_prometheus_client_golang//prometheus",
    ],
)

go_test(
    name = "pgbouncer_test",
    srcs = ["pgbouncer_test.go"],
    args = ["-test.v"],
    env_inherit = [
        "TADOKU_TEST_PGBOUNCER_URL",
        "TADOKU_TEST_POSTGRES_URL",
    ],
    tags = [
        "no-cache",
        "no-remote-exec",
        "requires-network",
    ],
    deps = [
        ":postgres",
        "//services/tadoku-api/internal/tenant",
        "//services/tadoku-api/internal/testpostgres",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

go_test(
    name = "postgres_test",
    srcs = [
        "errors_test.go",
        "pool_test.go",
        "sqlc_compat_test.go",
        "tenant_test.go",
        "timestamp_test.go",
        "transaction_test.go",
    ],
    args = ["-test.parallel=4"],
    env_inherit = ["TADOKU_TEST_POSTGRES_URL"],
    tags = [
        "no-cache",
        "no-remote-exec",
        "requires-network",
    ],
    deps = [
        ":postgres",
        "//services/tadoku-api/infra/postgres/internal/pgxcompat",
        "//services/tadoku-api/internal/errx",
        "//services/tadoku-api/internal/tenant",
        "//services/tadoku-api/internal/tenant/alltenants",
        "//services/tadoku-api/internal/testpostgres",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgerrcode//:pgerrcode",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgconn",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)
