load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "permissions",
    srcs = [
        "admission.go",
        "checker.go",
        "evaluate.go",
        "model.go",
        "namespace.go",
        "relationships.go",
        "rules.go",
        "store.go",
        "tenant_lifecycle.go",
        "types.go",
        "validate.go",
    ],
    importpath = "github.com/tadoku/tadoku/services/tadoku-api/internal/permissions",
    visibility = ["//services/tadoku-api:internal_consumers"],
    deps = [
        "//services/tadoku-api/infra/keto",
        "//services/tadoku-api/infra/relationships",
        "//services/tadoku-api/internal/errx",
        "//services/tadoku-api/internal/identity",
        "//services/tadoku-api/internal/tenant",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//pgxpool",
    ],
)

go_test(
    name = "permissions_test",
    size = "medium",
    srcs = [
        "checker_test.go",
        "engine_test.go",
        "fixtures_test.go",
        "model_test.go",
        "relationships_test.go",
        "tenant_lifecycle_test.go",
    ],
    args = ["-test.parallel=4"],
    embed = [":permissions"],
    env_inherit = ["TADOKU_TEST_POSTGRES_URL"],
    tags = [
        "no-cache",
        "no-remote-exec",
        "requires-network",
    ],
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    deps = [
        "//services/tadoku-api/infra/keto",
        "//services/tadoku-api/internal/errx",
        "//services/tadoku-api/internal/identity",
        "//services/tadoku-api/internal/tenant",
        "//services/tadoku-api/internal/testketo",
        "//services/tadoku-api/internal/testpostgres",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@com_github_ory_keto_client_go//:keto-client-go",
    ],
)
