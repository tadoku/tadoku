load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "testpostgres",
    testonly = True,
    srcs = ["database.go"],
    data = ["//services/immersion-api/storage/postgres/migrations:up_files"],
    embedsrcs = ["cleanup.sql"],
    importpath = "github.com/tadoku/tadoku/services/tadoku-api/internal/testpostgres",
    visibility = ["//services/tadoku-api:__subpackages__"],
    deps = [
        "@com_github_golang_migrate_migrate_v4//:migrate",
        "@com_github_golang_migrate_migrate_v4//database/postgres",
        "@com_github_golang_migrate_migrate_v4//source/file",
        "@com_github_google_uuid//:uuid",
        "@com_github_jackc_pgx_v5//:pgx",
        "@com_github_jackc_pgx_v5//pgxpool",
        "@rules_go//go/tools/bazel",
    ],
)

go_test(
    name = "testpostgres_test",
    srcs = ["database_test.go"],
    data = glob(["testdata/*.sql"]),
    embed = [":testpostgres"],
    env_inherit = ["TADOKU_TEST_POSTGRES_URL"],
    tags = [
        "no-cache",
        "no-remote-exec",
        "requires-network",
    ],
    deps = ["@com_github_jackc_pgx_v5//:pgx"],
)
