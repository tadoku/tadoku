load(":tlc.bzl", "tlc_test")

tlc_test(
    name = "jobqueue_test",
    config = "JobQueue.cfg",
    spec = "JobQueue.tla",
)

# Two jobs live at once, without replays.
tlc_test(
    name = "jobqueue_concurrent_test",
    config = "JobQueue_concurrent.cfg",
    spec = "JobQueue.tla",
)

# Two operators replaying one failed job and its replays.
tlc_test(
    name = "jobqueue_replay_test",
    config = "JobQueue_replay.cfg",
    spec = "JobQueue.tla",
)

# Two original jobs with a replay: larger bounds than CI runs.
tlc_test(
    name = "jobqueue_large_test",
    size = "medium",
    config = "JobQueue_large.cfg",
    spec = "JobQueue.tla",
    tags = ["manual"],
)

tlc_test(
    name = "accountdeletion_test",
    config = "AccountDeletion.cfg",
    spec = "AccountDeletion.tla",
)

# Known gap: CreateSession can insert a session after the deletion lock commits.
tlc_test(
    name = "accountdeletion_session_test",
    config = "AccountDeletion_session.cfg",
    spec = "AccountDeletion.tla",
    tags = ["manual"],
)

# Known gap: granting an administrator does not check for a ban.
tlc_test(
    name = "accountdeletion_roles_test",
    config = "AccountDeletion_roles.cfg",
    spec = "AccountDeletion.tla",
    tags = ["manual"],
)
