module(name = "tadoku_oapi_codegen_v2")

bazel_dep(name = "rules_go", version = "0.62.0")
bazel_dep(name = "gazelle", version = "0.52.2")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(
    name = "tadoku_oapi_codegen_v2_go_sdk",
    go_mod = "//:go.mod",
)
use_repo(go_sdk, "tadoku_oapi_codegen_v2_go_sdk")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_getkin_kin_openapi",
    "com_github_oapi_codegen_oapi_codegen_v2",
    "com_github_speakeasy_api_openapi",
    "com_github_stretchr_testify",
    "in_gopkg_yaml_v3",
    "in_yaml_go_yaml_v3",
    "org_golang_x_mod",
    "org_golang_x_text",
    "org_golang_x_tools",
)
